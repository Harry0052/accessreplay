{
  "name": "accessreplay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Replay a keyboard accessibility journey and name the first semantic divergence.",
  "license": "MIT",
  "engines": {
    "node": ">=22 <23"
  },
  "bin": {
    "accessreplay": "cli.mjs"
  },
  "scripts": {
    "check": "node --check cli.mjs && node --check src/*.mjs && node --check test/*.mjs",
    "test": "node --test --test-concurrency=1",
    "validate:fixture": "node cli.mjs validate fixtures/journeys/checkout.journey.json",
    "verify:manifest": "node cli.mjs verify-manifest"
  },
  "dependencies": {
    "@axe-core/playwright": "4.14.0",
    "playwright": "1.65.1"
  }
}
