    "equals": "true"
  },
  "steps": [
    {
      "id": "goto-away",
      "action": { "type": "goto", "url": "https://example.com" },
      "expect": {
        "role": "document",
        "name": "Example",
        "focusId": "body",
        "liveRegion": "",
        "appState": "browsing"
      }
    }
  ]
}
